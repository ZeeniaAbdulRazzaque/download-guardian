# Download Guardian - Environment Variables (Stateless / Ephemeral Mode)
PORT=5000
NODE_ENV=production

# Threat Intelligence (VirusTotal API v3)
# Optional: Register for a free API key at https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Storage & Privacy Settings
STORAGE_PATH=storage/quarantine
MAX_FILE_SIZE_MB=100
AUTO_DELETE_BINARIES=true

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
